// RUN: cir-opt %s --verify-roundtrip | FileCheck %s

!s32i = !cir.int<s, 32>
!u32i = !cir.int<u, 32>
!s8i = !cir.int<s, 8>
!u8i = !cir.int<u, 8>

cir.func @atomic_xchg(%ptr: !cir.ptr<!s32i>, %val: !s32i) {
  // CHECK-LABEL: @atomic_xchg
  %0 = cir.atomic.xchg relaxed %ptr, %val : (!cir.ptr<!s32i>, !s32i) -> !s32i
  // CHECK: cir.atomic.xchg relaxed %{{.+}}, %{{.+}} : (!cir.ptr<!s32i>, !s32i) -> !s32i
  %1 = cir.atomic.xchg consume %ptr, %val : (!cir.ptr<!s32i>, !s32i) -> !s32i
  // CHECK: cir.atomic.xchg consume %{{.+}}, %{{.+}} : (!cir.ptr<!s32i>, !s32i) -> !s32i
  %2 = cir.atomic.xchg acquire %ptr, %val : (!cir.ptr<!s32i>, !s32i) -> !s32i
  // CHECK: cir.atomic.xchg acquire %{{.+}}, %{{.+}} : (!cir.ptr<!s32i>, !s32i) -> !s32i
  %3 = cir.atomic.xchg release %ptr, %val : (!cir.ptr<!s32i>, !s32i) -> !s32i
  // CHECK: cir.atomic.xchg release %{{.+}}, %{{.+}} : (!cir.ptr<!s32i>, !s32i) -> !s32i
  %4 = cir.atomic.xchg acq_rel %ptr, %val : (!cir.ptr<!s32i>, !s32i) -> !s32i
  // CHECK: cir.atomic.xchg acq_rel %{{.+}}, %{{.+}} : (!cir.ptr<!s32i>, !s32i) -> !s32i
  %5 = cir.atomic.xchg seq_cst %ptr, %val : (!cir.ptr<!s32i>, !s32i) -> !s32i
  // CHECK: cir.atomic.xchg seq_cst %{{.+}}, %{{.+}} : (!cir.ptr<!s32i>, !s32i) -> !s32i
  cir.return
}

cir.func @atomic_cmpxchg(%ptr: !cir.ptr<!s32i>, %expected: !s32i, %desired: !s32i) {
  // CHECK-LABEL: @atomic_cmpxchg
  %0, %1 = cir.atomic.cmpxchg success(relaxed) failure(relaxed) %ptr, %expected, %desired : (!cir.ptr<!s32i>, !s32i, !s32i) -> (!s32i, !cir.bool)
  // CHECK: cir.atomic.cmpxchg success(relaxed) failure(relaxed) %{{.+}}, %{{.+}}, %{{.+}} : (!cir.ptr<!s32i>, !s32i, !s32i) -> (!s32i, !cir.bool)
  %2, %3 = cir.atomic.cmpxchg weak success(relaxed) failure(relaxed) %ptr, %expected, %desired : (!cir.ptr<!s32i>, !s32i, !s32i) -> (!s32i, !cir.bool)
  // CHECK: cir.atomic.cmpxchg weak success(relaxed) failure(relaxed) %{{.+}}, %{{.+}}, %{{.+}} : (!cir.ptr<!s32i>, !s32i, !s32i) -> (!s32i, !cir.bool)
  %4, %5 = cir.atomic.cmpxchg success(seq_cst) failure(acquire) %ptr, %expected, %desired : (!cir.ptr<!s32i>, !s32i, !s32i) -> (!s32i, !cir.bool)
  // CHECK: cir.atomic.cmpxchg success(seq_cst) failure(acquire) %{{.+}}, %{{.+}}, %{{.+}} : (!cir.ptr<!s32i>, !s32i, !s32i) -> (!s32i, !cir.bool)
  %6, %7 = cir.atomic.cmpxchg weak success(seq_cst) failure(acquire) %ptr, %expected, %desired : (!cir.ptr<!s32i>, !s32i, !s32i) -> (!s32i, !cir.bool)
  // CHECK: cir.atomic.cmpxchg weak success(seq_cst) failure(acquire) %{{.+}}, %{{.+}}, %{{.+}} : (!cir.ptr<!s32i>, !s32i, !s32i) -> (!s32i, !cir.bool)
  cir.return
}

cir.func @atomic_xchg_syncscope(%ptr: !cir.ptr<!s32i>, %val: !s32i) {
  // CHECK-LABEL: @atomic_xchg_syncscope
  %0 = cir.atomic.xchg seq_cst %ptr, %val syncscope(single_thread) : (!cir.ptr<!s32i>, !s32i) -> !s32i
  // CHECK: cir.atomic.xchg seq_cst %{{.+}}, %{{.+}} syncscope(single_thread) : (!cir.ptr<!s32i>, !s32i) -> !s32i
  %1 = cir.atomic.xchg seq_cst %ptr, %val syncscope(system) : (!cir.ptr<!s32i>, !s32i) -> !s32i
  // CHECK: cir.atomic.xchg seq_cst %{{.+}}, %{{.+}} syncscope(system) : (!cir.ptr<!s32i>, !s32i) -> !s32i
  cir.return
}

cir.func @atomic_fetch_syncscope(%ptr: !cir.ptr<!s32i>, %val: !s32i) {
  // CHECK-LABEL: @atomic_fetch_syncscope
  %0 = cir.atomic.fetch add seq_cst fetch_first %ptr, %val syncscope(single_thread) : (!cir.ptr<!s32i>, !s32i) -> !s32i
  // CHECK: cir.atomic.fetch add seq_cst fetch_first %{{.+}}, %{{.+}} syncscope(single_thread) : (!cir.ptr<!s32i>, !s32i) -> !s32i
  %1 = cir.atomic.fetch sub seq_cst %ptr, %val syncscope(system) : (!cir.ptr<!s32i>, !s32i) -> !s32i
  // CHECK: cir.atomic.fetch sub seq_cst %{{.+}}, %{{.+}} syncscope(system) : (!cir.ptr<!s32i>, !s32i) -> !s32i
  cir.return
}

cir.func @atomic_test_and_set_syncscope(%ptr: !cir.ptr<!s8i>) {
  // CHECK-LABEL: @atomic_test_and_set_syncscope
  %0 = cir.atomic.test_and_set seq_cst %ptr syncscope(single_thread) : !cir.ptr<!s8i> -> !cir.bool {alignment = 1 : i64}
  // CHECK: cir.atomic.test_and_set seq_cst %{{.+}} syncscope(single_thread) : !cir.ptr<!s8i> -> !cir.bool
  cir.return
}

cir.func @atomic_clear_syncscope(%ptr: !cir.ptr<!s8i>) {
  // CHECK-LABEL: @atomic_clear_syncscope
  cir.atomic.clear seq_cst %ptr syncscope(single_thread) : !cir.ptr<!s8i> {alignment = 1 : i64}
  // CHECK: cir.atomic.clear seq_cst %{{.+}} syncscope(single_thread) : !cir.ptr<!s8i>
  cir.return
}

// Verify that unsigned i8 pointers are accepted (AArch64 char is unsigned).
cir.func @atomic_test_and_set_unsigned(%ptr: !cir.ptr<!u8i>) {
  // CHECK-LABEL: @atomic_test_and_set_unsigned
  %0 = cir.atomic.test_and_set seq_cst %ptr : !cir.ptr<!u8i> -> !cir.bool {alignment = 1 : i64}
  // CHECK: cir.atomic.test_and_set seq_cst %{{.+}} : !cir.ptr<!u8i> -> !cir.bool
  cir.return
}

cir.func @atomic_clear_unsigned(%ptr: !cir.ptr<!u8i>) {
  // CHECK-LABEL: @atomic_clear_unsigned
  cir.atomic.clear seq_cst %ptr : !cir.ptr<!u8i> {alignment = 1 : i64}
  // CHECK: cir.atomic.clear seq_cst %{{.+}} : !cir.ptr<!u8i>
  cir.return
}
