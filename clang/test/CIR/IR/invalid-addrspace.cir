// RUN: cir-opt %s -verify-diagnostics -split-input-file

// -----

!u64i = !cir.int<u, 64>
// expected-error @below {{unexpected address-space attribute kind}}
cir.func @address_space1(%p : !cir.ptr<!u64i, foobar>) {
  cir.return
}

// -----

!u64i = !cir.int<u, 64>
// expected-error@below {{expected '(' after target address space}}
// expected-error@below {{expected '('}}
cir.func @address_space2(%p : !cir.ptr<!u64i, target_address_space>) {
  cir.return
}

// -----

!u64i = !cir.int<u, 64>
// expected-error@below {{unexpected address-space attribute kind}}
cir.func @address_space3(%p : !cir.ptr<!u64i, target<>>) {
  cir.return
}
