// RUN: cir-opt %s -cir-to-llvm -o %t.cir
// RUN: FileCheck %s --input-file=%t.cir
//
// Regression test: TrapOp lowering must not
// erase the op before creating replacements (use-after-erase crash).

!s32i = !cir.int<s, 32>

module {
  cir.func @trap_lowering() -> !s32i {
    cir.trap
    // CHECK-LABEL: llvm.func @trap_lowering
    // CHECK: llvm.intr.trap
    // CHECK: llvm.unreachable
  }
}
