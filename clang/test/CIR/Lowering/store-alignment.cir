// RUN: cir-translate %s -cir-to-llvmir --target x86_64-unknown-linux-gnu --disable-cc-lowering | FileCheck %s
// Tests that store operations compute alignment from the memory type (i8 for
// bool) rather than the register type (i1). This is important because LLVM
// alignment computations should use the in-memory representation.

!s8i = !cir.int<s, 8>
!u8i = !cir.int<u, 8>
!s32i = !cir.int<s, 32>

module {
  // Bool store should use align 1 (from i8 memory type, not i1 register type)
  cir.func @test_bool_store(%arg0: !cir.ptr<!cir.bool>, %arg1: !cir.bool) {
    cir.store %arg1, %arg0 : !cir.bool, !cir.ptr<!cir.bool>
    cir.return
  }
  // CHECK-LABEL: define void @test_bool_store
  // CHECK: store i8 %{{.*}}, ptr %{{.*}}, align 1

  // Regular int store should use align 4
  cir.func @test_int_store(%arg0: !cir.ptr<!s32i>, %arg1: !s32i) {
    cir.store %arg1, %arg0 : !s32i, !cir.ptr<!s32i>
    cir.return
  }
  // CHECK-LABEL: define void @test_int_store
  // CHECK: store i32 %{{.*}}, ptr %{{.*}}, align 4

  // Byte store should use align 1
  cir.func @test_byte_store(%arg0: !cir.ptr<!s8i>, %arg1: !s8i) {
    cir.store %arg1, %arg0 : !s8i, !cir.ptr<!s8i>
    cir.return
  }
  // CHECK-LABEL: define void @test_byte_store
  // CHECK: store i8 %{{.*}}, ptr %{{.*}}, align 1
}
