// Verify that nested fused locations on cir.func are handled correctly
// during direct lowering. This can happen when debug metadata attributes
// like di_scope_column/di_scope_line wrap the function's file location.
//
// RUN: cir-opt %s -cir-to-llvm -o - | FileCheck %s

!void = !cir.void

// The function location is a nested fused loc:
//   fused<{di_atom_group}>[fused<{di_scope_column, di_scope_line}>["file":line:col]]
#inner = loc(fused<{llvm.di_scope_column = 2 : i32, llvm.di_scope_line = 10 : i32}>["func-nested-fused-loc.c":10:2])
#outer = loc(fused<{llvm.di_atom_group = 6 : i64, llvm.di_atom_rank = 2 : i8}>[#inner])

// CHECK: llvm.func @nested_fused_loc()
module attributes {
  cir.lang = #cir.lang<c>,
  cir.triple = "x86_64-unknown-linux-gnu",
  cir.type_size_info = #cir.type_size_info<char = 8, int = 32, size_t = 64>
} {
  cir.func @nested_fused_loc() -> !void {
    cir.return
  } loc(#outer)
} loc("func-nested-fused-loc.c":0:0)
