// RUN: cir-translate %s -cir-to-llvmir --target x86_64-unknown-linux-gnu --disable-cc-lowering | FileCheck %s --check-prefix=LLVM

!s32i = !cir.int<s, 32>

module {
  cir.func private @callee() -> !s32i

  cir.func @caller() -> !s32i {
    %0 = cir.get_global @callee : !cir.ptr<!cir.func<() -> !s32i>>
    %1 = cir.call @callee(%0) {cir.static_chain} : (!cir.ptr<!cir.func<() -> !s32i>>) -> !s32i
    cir.return %1 : !s32i
  }

  // LLVM: declare {{.*}} i32 @callee()
  // LLVM-LABEL: define i32 @caller()
  // LLVM: call i32 @callee(ptr nest noundef @callee)
  // LLVM: ret i32 %{{.*}}
}
