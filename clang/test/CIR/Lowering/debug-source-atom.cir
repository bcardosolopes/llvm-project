// RUN: cir-opt %s -cir-to-llvm --mlir-print-debuginfo -o - | FileCheck %s --check-prefix=MLIR
// RUN: cir-translate %s -cir-to-llvmir --target x86_64-unknown-linux-gnu --disable-cc-lowering -o - | FileCheck %s --check-prefix=LLVM

!void = !cir.void

#src = loc("debug-source-atom.c":7:3)
#fn = loc("debug-source-atom.c":7:1)

// MLIR: llvm.func @atom()
// MLIR: llvm.return loc(#loc[[ATOM:[0-9]+]])
// MLIR: #loc[[SRC:[0-9]+]] = loc("debug-source-atom.c":7:3)
// MLIR: #loc[[ATOM]] = loc(fused<{llvm.di_atom_group = 9 : i64, llvm.di_atom_rank = 2 : i8}>[#loc[[SRC]]])
//
// LLVM: define void @atom() !dbg ![[SP:[0-9]+]]
// LLVM: ret void, !dbg ![[LOC:[0-9]+]]
// LLVM: ![[SP]] = distinct !DISubprogram(name: "atom"
// LLVM: ![[LOC]] = !DILocation(line: 7, column: 3, scope: ![[SP]], atomGroup: 9, atomRank: 2)
module attributes {
  cir.debug_dwarf_version = 5 : i32,
  cir.debug_emission_kind = 1 : i32,
  cir.debug_lang = 2 : i32,
  cir.debug_name_table_kind = 2 : i32,
  cir.debug_key_instructions,
  cir.debug_producer = "test",
  cir.debug_debugger_tuning = 1 : i32,
  cir.debug_no_split_debug_inlining,
  cir.lang = #cir.lang<c>,
  cir.triple = "x86_64-unknown-linux-gnu",
  cir.type_size_info = #cir.type_size_info<char = 8, int = 32, size_t = 64>
} {
  cir.func @atom() -> !void {
    cir.return loc(fused<{"llvm.di_atom_group" = 9 : i64, "llvm.di_atom_rank" = 2 : i8}>[#src])
  } loc(#fn)
} loc("debug-source-atom.c":0:0)
