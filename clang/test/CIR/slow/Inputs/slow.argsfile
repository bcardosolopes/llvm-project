-cc1
-triple
aarch64-none-linux-android24
-Os
-emit-obj
-disable-free
-clear-ast-before-backend
-main-file-name
main.cpp
-mrelocation-model
pic
-pic-level
2
-mframe-pointer=none
-relaxed-aliasing
-ffp-contract=on
-fno-rounding-math
-mconstructor-aliases
-funwind-tables=1
-enable-tlsdesc
