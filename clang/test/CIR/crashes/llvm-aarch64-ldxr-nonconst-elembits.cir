// RUN: not cir-opt %s -cir-to-llvm -o /dev/null 2>&1 | FileCheck %s
// CHECK: error: llvm.aarch64.ldxr requires constant integer elemBits operand > 0
// CHECK-NOT: invalid element type width
// CHECK-NOT: Stack dump:

!s32i = !cir.int<s, 32>
!s64i = !cir.int<s, 64>

module {
  cir.func @foo(%a: !cir.ptr<!s32i>, %bits: !s32i) {
    %i = cir.call_llvm_intrinsic "aarch64.ldxr" %a, %bits : (!cir.ptr<!s32i>, !s32i) -> !s64i
    cir.return
  }
}
