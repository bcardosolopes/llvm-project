// RUN: not cir-opt %s -cir-to-llvm -o /dev/null 2>&1 | FileCheck %s
// CHECK: error: failed to lower poison constant type
// CHECK: !rec_R
// CHECK-NOT: Stack dump:
// CHECK-NOT: Segmentation fault

!s32i = !cir.int<s, 32>
!p = !cir.ptr<!s32i, lang_address_space(offload_global)>
!rec_R = !cir.record<struct "R" {!p}>

module {
  cir.func private @f() {
    %0 = cir.const #cir.poison : !rec_R
    cir.return
  }
}
