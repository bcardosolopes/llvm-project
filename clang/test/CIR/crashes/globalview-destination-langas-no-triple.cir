// RUN: not cir-opt %s -cir-to-llvm -o /dev/null 2>&1 | FileCheck %s
// CHECK: error: failed to lower #cir.global_view destination pointer type
// CHECK-SAME: lang_address_space(offload_global)
// CHECK-NOT: Stack dump:
// CHECK-NOT: Segmentation fault

!s32i = !cir.int<s, 32>

module {
  cir.global external @g = #cir.int<0> : !s32i
  cir.func private @f() {
    %0 = cir.const #cir.global_view<@g> : !cir.ptr<!s32i, lang_address_space(offload_global)>
    cir.return
  }
}
