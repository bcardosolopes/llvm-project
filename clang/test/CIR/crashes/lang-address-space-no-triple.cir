// RUN: not cir-opt %s -cir-to-llvm -split-input-file -o /dev/null 2>&1 | FileCheck %s
// CHECK: error: cannot lower global lang_address_space without module target triple
// CHECK-NOT: Assertion `lowerModule && "CIR AS map is not available"' failed.
// CHECK-NOT: Stack dump:

!s32i = !cir.int<s, 32>

module {
  cir.global external lang_address_space(offload_global) @g = #cir.int<0> : !s32i
}

// -----

!s32i = !cir.int<s, 32>

module {
  cir.global external lang_address_space(offload_global) @arr =
      #cir.const_array<[#cir.int<1> : !s32i]> : !cir.array<!s32i x 1>
}

// -----

!s32i = !cir.int<s, 32>

module {
  cir.global external @h = #cir.global_view<@g> : !s32i
  cir.global external lang_address_space(offload_global) @g = #cir.int<1> : !s32i
}
