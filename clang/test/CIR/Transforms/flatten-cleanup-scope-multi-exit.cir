cir.func private @shouldGoto() -> !cir.bool

// Test that a goto out of a cleanup scope gets its own copy of the cleanup
// region. The original goto is replaced by a branch to the cleanup copy,
// which falls through to a new cir.goto to the same label.
cir.func @test_multi_exit_with_goto() {
  %0 = cir.alloca "c" align(4) init : !cir.ptr<!rec_SomeClass>
  cir.call @ctor(%0) : (!cir.ptr<!rec_SomeClass>) -> ()
  cir.cleanup.scope {
    %cond = cir.call @shouldGoto() : () -> !cir.bool
    cir.brcond %cond ^bb_goto, ^bb_normal
  ^bb_goto:
    cir.goto "exit"   // Goto through cleanup
  ^bb_normal:
    cir.yield         // Normal exit through cleanup
  } cleanup normal {
    cir.call @dtor(%0) : (!cir.ptr<!rec_SomeClass>) -> ()
    cir.yield
  }
  cir.br ^bb_end
^bb_end:
  cir.label "exit"
  cir.return
}

// CHECK-LABEL: cir.func @test_multi_exit_with_goto()
// CHECK:         %[[ALLOCA:.*]] = cir.alloca {{.*}} : !cir.ptr<!rec_SomeClass>
// CHECK:         cir.call @ctor(%[[ALLOCA]])
// CHECK:         cir.br ^[[BODY:bb[0-9]+]]
// CHECK:       ^[[BODY]]:
// CHECK:         %[[COND:.*]] = cir.call @shouldGoto()
// CHECK:         cir.brcond %[[COND]] ^[[GOTO_PATH:bb[0-9]+]], ^[[YIELD_PATH:bb[0-9]+]]
// CHECK:       ^[[GOTO_PATH]]:
// CHECK:         cir.br ^[[GOTO_CLEANUP:bb[0-9]+]]
// CHECK:       ^[[YIELD_PATH]]:
// CHECK:         cir.br ^[[YIELD_CLEANUP:bb[0-9]+]]
// CHECK:       ^[[YIELD_CLEANUP]]:
// CHECK:         cir.call @dtor(%[[ALLOCA]])
// CHECK:         cir.br ^[[CONTINUE:bb[0-9]+]]
// CHECK:       ^[[GOTO_CLEANUP]]:
// CHECK:         cir.call @dtor(%[[ALLOCA]])
// CHECK:         cir.goto "exit"
// CHECK:       ^[[CONTINUE]]:
// CHECK:         cir.br ^[[LABEL_BB:bb[0-9]+]]
// CHECK:       ^[[LABEL_BB]]:
// CHECK:         cir.label "exit"
// CHECK:         cir.return

// Test a goto inside nested cleanup scopes whose target label is outside both
// scopes. The goto must branch through both cleanups before reaching its
// target. Each cleanup gets its own copy per exit; the goto copy falls
// through to a re-emitted goto to the same label.
cir.func @test_goto_in_nested_cleanup() {
  %0 = cir.alloca "c1" align(4) init : !cir.ptr<!rec_SomeClass>
  %1 = cir.alloca "c2" align(4) init : !cir.ptr<!rec_SomeClass>
  cir.call @ctor(%0) : (!cir.ptr<!rec_SomeClass>) -> ()
  cir.cleanup.scope {
    cir.call @ctor(%1) : (!cir.ptr<!rec_SomeClass>) -> ()
    cir.cleanup.scope {
      %cond = cir.call @shouldGoto() : () -> !cir.bool
      cir.brcond %cond ^bb_goto, ^bb_normal
    ^bb_goto:
      cir.goto "target"   // Goto through BOTH cleanups
    ^bb_normal:
      cir.yield
    } cleanup normal {
      cir.call @dtor(%1) : (!cir.ptr<!rec_SomeClass>) -> ()
      cir.yield
    }
    cir.yield
  } cleanup normal {
    cir.call @dtor(%0) : (!cir.ptr<!rec_SomeClass>) -> ()
    cir.yield
  }
  cir.br ^bb_end
^bb_goto_target:
  cir.label "target"
  cir.br ^bb_end
^bb_end:
  cir.return
}

// CHECK-LABEL: cir.func @test_goto_in_nested_cleanup()
// CHECK:         %[[ALLOCA_C1:.*]] = cir.alloca "c1" {{.*}} : !cir.ptr<!rec_SomeClass>
// CHECK:         %[[ALLOCA_C2:.*]] = cir.alloca "c2" {{.*}} : !cir.ptr<!rec_SomeClass>
// CHECK:         cir.call @ctor(%[[ALLOCA_C1]])
// CHECK:         cir.br ^[[OUTER_BODY:bb[0-9]+]]
// CHECK:       ^[[OUTER_BODY]]:
// CHECK:         cir.call @ctor(%[[ALLOCA_C2]])
// CHECK:         cir.br ^[[INNER_BODY:bb[0-9]+]]
// CHECK:       ^[[INNER_BODY]]:
// CHECK:         %[[COND:.*]] = cir.call @shouldGoto()
// CHECK:         cir.brcond %[[COND]] ^[[GOTO_PATH:bb[0-9]+]], ^[[YIELD_PATH:bb[0-9]+]]
// CHECK:       ^[[GOTO_PATH]]:
// CHECK:         cir.br ^[[INNER_GOTO_CLEANUP:bb[0-9]+]]
// CHECK:       ^[[YIELD_PATH]]:
// CHECK:         cir.br ^[[INNER_YIELD_CLEANUP:bb[0-9]+]]
// CHECK:       ^[[INNER_YIELD_CLEANUP]]:
// CHECK:         cir.call @dtor(%[[ALLOCA_C2]])
// CHECK:         cir.br ^[[OUTER_YIELD_CLEANUP:bb[0-9]+]]
// CHECK:       ^[[INNER_GOTO_CLEANUP]]:
