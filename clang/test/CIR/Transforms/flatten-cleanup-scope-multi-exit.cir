// CHECK:       ^[[LOOP_COND]]:
// CHECK:         %[[TRUE:.*]] = cir.const #true
// CHECK:         cir.brcond %[[TRUE]] ^[[LOOP_BODY:bb[0-9]+]], ^[[LOOP_EXIT:bb[0-9]+]]
// CHECK:       ^[[LOOP_BODY]]:
// CHECK:         cir.call @ctor(%[[ALLOCA_C1]])
// CHECK:         cir.br ^[[CLEANUP_BODY:bb[0-9]+]]
// CHECK:       ^[[CLEANUP_BODY]]:
// CHECK:         %[[X:.*]] = cir.load %[[ALLOCA_X]]
// CHECK:         cir.br ^[[SWITCH_ENTRY:bb[0-9]+]]
