// CHECK:       ^[[RET_PATH]]:
// CHECK:         cir.store %[[ARG0]], %[[RET_TMP]]
// CHECK:         cir.br ^[[INNER_RET_CLEANUP:bb[0-9]+]]
// CHECK:       ^[[YIELD_PATH]]:
// CHECK:         cir.br ^[[INNER_YIELD_CLEANUP:bb[0-9]+]]
// CHECK:       ^[[INNER_YIELD_CLEANUP]]:
// CHECK:         cir.call @dtor(%[[ALLOCA_C2]])
// CHECK:         cir.br ^[[OUTER_YIELD_CLEANUP:bb[0-9]+]]
// CHECK:       ^[[INNER_RET_CLEANUP]]:
// CHECK:         cir.call @dtor(%[[ALLOCA_C2]])
// CHECK:         cir.br ^[[OUTER_RET_CLEANUP:bb[0-9]+]]
// CHECK:       ^[[OUTER_YIELD_CLEANUP]]:
// CHECK:         cir.br ^[[OUTER_YIELD_DTOR:bb[0-9]+]]
// CHECK:       ^[[OUTER_YIELD_DTOR]]:
// CHECK:         cir.call @dtor(%[[ALLOCA_C1]])
// CHECK:         cir.br ^[[FINAL_RET:bb[0-9]+]]
// CHECK:       ^[[OUTER_RET_CLEANUP]]:
// CHECK:         cir.call @dtor(%[[ALLOCA_C1]])
