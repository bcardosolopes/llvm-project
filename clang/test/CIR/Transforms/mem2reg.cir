// RUN: cir-opt %s -cir-flatten-cfg -mem2reg -o - | FileCheck %s

!s32i = !cir.int<s, 32>
!u8i = !cir.int<u, 8>
!u16i = !cir.int<u, 16>
!rec_Whole = !cir.struct<"Whole" {data !u16i, data !u16i}>
!rec_AllPad = !cir.struct<"AllPad" {pad !u8i}>
!rec_A = !cir.struct<"A" {data !s32i}>
!rec_B = !cir.struct<"B" {data !s32i}>

module {
  // Promote CIR stack slots through the generic mem2reg pass after CFG flattening.
  // CHECK-LABEL: cir.func @promote_simple_stack_slots
  cir.func @promote_simple_stack_slots() -> !s32i {
    // CHECK: %[[CONST:.*]] = cir.const #cir.int<42>
    // CHECK: cir.return %[[CONST]]
    %0 = cir.alloca "__retval" align(4) : !cir.ptr<!s32i>
    %1 = cir.alloca "y" align(4) init : !cir.ptr<!s32i>
    %2 = cir.const #cir.int<42> : !s32i
    cir.store %2, %1 : !s32i, !cir.ptr<!s32i>
    %3 = cir.load %1 : !cir.ptr<!s32i>, !s32i
    cir.store %3, %0 : !s32i, !cir.ptr<!s32i>
    %4 = cir.load %0 : !cir.ptr<!s32i>, !s32i
    cir.return %4 : !s32i
  }

  // CHECK-LABEL: cir.func @do_not_promote_volatile
  cir.func @do_not_promote_volatile_load() -> !s32i {
    // CHECK: %[[ALLOCA:.*]] = cir.alloca "y" align(4) init : !cir.ptr<!s32i>
    // CHECK: %[[RET:.+]] = cir.load volatile %[[ALLOCA]] : !cir.ptr<!s32i>, !s32i
    // CHECK: cir.return %[[RET]] : !s32i
    %0 = cir.alloca "y" align(4) init : !cir.ptr<!s32i>
    %1 = cir.const #cir.int<42> : !s32i
    cir.store %1, %0 : !s32i, !cir.ptr<!s32i>
    %2 = cir.load volatile %0 : !cir.ptr<!s32i>, !s32i
    cir.return %2 : !s32i
  }

  // CHECK-LABEL: cir.func @do_not_promote_volatile_store
  cir.func @do_not_promote_volatile_store() -> !s32i {
    // CHECK: %[[ALLOCA:.*]] = cir.alloca "y" align(4) init : !cir.ptr<!s32i>
    // CHECK: cir.store volatile %{{.+}}, %[[ALLOCA]] : !s32i, !cir.ptr<!s32i>
    // CHECK: %[[RET:.+]] = cir.load %[[ALLOCA]] : !cir.ptr<!s32i>, !s32i
    // CHECK: cir.return %[[RET]] : !s32i
    %0 = cir.alloca "y" align(4) init : !cir.ptr<!s32i>
    %1 = cir.const #cir.int<42> : !s32i
    cir.store volatile %1, %0 : !s32i, !cir.ptr<!s32i>
    %2 = cir.load %0 : !cir.ptr<!s32i>, !s32i
    cir.return %2 : !s32i
  }

  // CHECK-LABEL: cir.func @do_not_promote_atomic_load
  cir.func @do_not_promote_atomic_load() -> !s32i {
    // CHECK: %[[ALLOCA:.*]] = cir.alloca "y" align(4) init : !cir.ptr<!s32i>
    // CHECK: %[[RET:.+]] = cir.load atomic(acquire) %[[ALLOCA]] : !cir.ptr<!s32i>, !s32i
    // CHECK: cir.return %[[RET]] : !s32i
    %0 = cir.alloca "y" align(4) init : !cir.ptr<!s32i>
    %1 = cir.const #cir.int<42> : !s32i
    cir.store %1, %0 : !s32i, !cir.ptr<!s32i>
    %2 = cir.load atomic(acquire) %0 : !cir.ptr<!s32i>, !s32i
    cir.return %2 : !s32i
  }

  // CHECK-LABEL: cir.func @do_not_promote_atomic_store
  cir.func @do_not_promote_atomic_store() -> !s32i {
    // CHECK: %[[ALLOCA:.*]] = cir.alloca "y" align(4) init : !cir.ptr<!s32i>
    // CHECK: cir.store atomic(release) %{{.+}}, %[[ALLOCA]] : !s32i, !cir.ptr<!s32i>
    // CHECK: %[[RET:.+]] = cir.load %[[ALLOCA]] : !cir.ptr<!s32i>, !s32i
    // CHECK: cir.return %[[RET]] : !s32i
    %0 = cir.alloca "y" align(4) init : !cir.ptr<!s32i>
    %1 = cir.const #cir.int<42> : !s32i
    cir.store atomic(release) %1, %0 : !s32i, !cir.ptr<!s32i>
    %2 = cir.load %0 : !cir.ptr<!s32i>, !s32i
    cir.return %2 : !s32i
  }

  // A skip_tail_padding copy that covers the whole slot still promotes.
  // CHECK-LABEL: cir.func @promote_copy_covering_slot
  cir.func @promote_copy_covering_slot(%src: !cir.ptr<!rec_Whole>) -> !rec_Whole {
    // CHECK-NOT: cir.alloca
    // CHECK-NOT: cir.copy
    %slot = cir.alloca "s" align(2) init : !cir.ptr<!rec_Whole>
    cir.copy %src to %slot skip_tail_padding : !cir.ptr<!rec_Whole>
    %v = cir.load %slot : !cir.ptr<!rec_Whole>, !rec_Whole
    cir.return %v : !rec_Whole
  }

  // An all-pad record has a data size of zero, so the copy leaves the slot's
  // byte untouched and the slot cannot be promoted.
  // CHECK-LABEL: cir.func @do_not_promote_partial_copy
  cir.func @do_not_promote_partial_copy(%src: !cir.ptr<!rec_AllPad>) -> !rec_AllPad {
    // CHECK: %[[SLOT:.*]] = cir.alloca "s" align(1) init : !cir.ptr<!rec_AllPad>
    // CHECK: cir.copy %{{.+}} to %[[SLOT]] skip_tail_padding : !cir.ptr<!rec_AllPad>
    %slot = cir.alloca "s" align(1) init : !cir.ptr<!rec_AllPad>
    cir.copy %src to %slot skip_tail_padding : !cir.ptr<!rec_AllPad>
    %v = cir.load %slot : !cir.ptr<!rec_AllPad>, !rec_AllPad
    cir.return %v : !rec_AllPad
  }

  // A copy that reaches the slot only through a bitcast does not promote,
  // even when it covers the whole slot: mem2reg's merge analysis would not
  // count the copying block as defining the slot.
  // CHECK-LABEL: cir.func @do_not_promote_copy_to_bitcast_slot
  cir.func @do_not_promote_copy_to_bitcast_slot(%src: !cir.ptr<!rec_B>) -> !rec_A {
    // CHECK: %[[SLOT:.*]] = cir.alloca "s" align(4) init : !cir.ptr<!rec_A>
    // CHECK: cir.copy %{{.+}} to %{{.+}} : !cir.ptr<!rec_B>
    // CHECK: cir.load %[[SLOT]] : !cir.ptr<!rec_A>, !rec_A
    %slot = cir.alloca "s" align(4) init : !cir.ptr<!rec_A>
    %bc = cir.cast bitcast %slot : !cir.ptr<!rec_A> -> !cir.ptr<!rec_B>
    cir.copy %src to %bc : !cir.ptr<!rec_B>
    %v = cir.load %slot : !cir.ptr<!rec_A>, !rec_A
    cir.return %v : !rec_A
  }

  // Same as above, but the slot is on the loaded (source) side of the copy.
  // CHECK-LABEL: cir.func @do_not_promote_copy_from_bitcast_slot
  cir.func @do_not_promote_copy_from_bitcast_slot(%v: !rec_A, %dst: !cir.ptr<!rec_B>) {
    // CHECK: %[[SLOT:.*]] = cir.alloca "s" align(4) init : !cir.ptr<!rec_A>
    // CHECK: cir.store %{{.+}}, %[[SLOT]] : !rec_A, !cir.ptr<!rec_A>
    // CHECK: cir.copy %{{.+}} to %{{.+}} : !cir.ptr<!rec_B>
    %slot = cir.alloca "s" align(4) init : !cir.ptr<!rec_A>
    cir.store %v, %slot : !rec_A, !cir.ptr<!rec_A>
    %bc = cir.cast bitcast %slot : !cir.ptr<!rec_A> -> !cir.ptr<!rec_B>
    cir.copy %bc to %dst : !cir.ptr<!rec_B>
    cir.return
  }

  // Lifetime markers on a promoted slot go with it: the slot is no longer
  // on the stack, so they mean nothing.
  // CHECK-LABEL: cir.func @promote_slot_with_lifetime_markers
  cir.func @promote_slot_with_lifetime_markers() -> !s32i {
    // CHECK-NOT: cir.alloca
    // CHECK-NOT: cir.lifetime
    // CHECK: cir.return
    %slot = cir.alloca "s" align(4) : !cir.ptr<!s32i>
    cir.lifetime.start %slot : !cir.ptr<!s32i>
    %c = cir.const #cir.int<42> : !s32i
    cir.store %c, %slot : !s32i, !cir.ptr<!s32i>
    %v = cir.load %slot : !cir.ptr<!s32i>, !s32i
    cir.lifetime.end %slot : !cir.ptr<!s32i>
    cir.return %v : !s32i
  }

  // A volatile copy is externally observable and must survive mem2reg,
  // so its slot does not promote.
  // CHECK-LABEL: cir.func @do_not_promote_volatile_copy
  cir.func @do_not_promote_volatile_copy(%src: !cir.ptr<!rec_Whole>) -> !rec_Whole {
    // CHECK: %[[SLOT:.*]] = cir.alloca "s" align(2) init : !cir.ptr<!rec_Whole>
    // CHECK: cir.copy %{{.+}} to %[[SLOT]] volatile : !cir.ptr<!rec_Whole>
    // CHECK: cir.load %[[SLOT]] : !cir.ptr<!rec_Whole>, !rec_Whole
    %slot = cir.alloca "s" align(2) init : !cir.ptr<!rec_Whole>
    cir.copy %src to %slot volatile : !cir.ptr<!rec_Whole>
    %v = cir.load %slot : !cir.ptr<!rec_Whole>, !rec_Whole
    cir.return %v : !rec_Whole
  }

  // A bitcast copy on one side of a diamond must not promote either:
  // promoting it would compute the copied value but drop it at the merge,
  // reading the slot's default instead.
  // CHECK-LABEL: cir.func @do_not_promote_bitcast_copy_diamond
  cir.func @do_not_promote_bitcast_copy_diamond(%cond: !cir.bool, %src: !cir.ptr<!rec_B>) -> !rec_A {
    // CHECK: %[[SLOT:.*]] = cir.alloca "s" align(4) init : !cir.ptr<!rec_A>
    // CHECK: cir.copy %{{.+}} to %{{.+}} : !cir.ptr<!rec_B>
    // CHECK: cir.load %[[SLOT]] : !cir.ptr<!rec_A>, !rec_A
    %slot = cir.alloca "s" align(4) init : !cir.ptr<!rec_A>
    cir.brcond %cond ^store, ^skip
  ^store:
    %bc = cir.cast bitcast %slot : !cir.ptr<!rec_A> -> !cir.ptr<!rec_B>
    cir.copy %src to %bc : !cir.ptr<!rec_B>
    cir.br ^merge
  ^skip:
    cir.br ^merge
  ^merge:
    %v = cir.load %slot : !cir.ptr<!rec_A>, !rec_A
    cir.return %v : !rec_A
  }
}
