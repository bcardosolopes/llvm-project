 // RUN: cir-opt %s -cir-hoist-allocas -o - | FileCheck %s

!s32i = !cir.int<s, 32>
#true = #cir.bool<true> : !cir.bool

module {
  cir.func @l1() {
    cir.scope {
      %0 = cir.alloca !s32i, !cir.ptr<!s32i>, ["i", init] {alignment = 4 : i64}
      %1 = cir.const #cir.int<0> : !s32i
      cir.store %1, %0 : !s32i, !cir.ptr<!s32i>
      cir.for : cond {
        %2 = cir.const #true
        cir.condition(%2)
      } body {
       cir.yield
      } step {
        cir.yield
      }
    }
    cir.return
  }
  // CHECK:      cir.func{{.*}} @l1
  // CHECK-NEXT:   %[[I:.*]] = cir.alloca !s32i, !cir.ptr<!s32i>, ["i", init] {alignment = 4 : i64}
  // CHECK-NEXT:   cir.scope {
  // CHECK-NEXT:     %[[ZERO:.*]] = cir.const #cir.int<0> : !s32i
  // CHECK-NEXT:     cir.store %[[ZERO]], %[[I]] : !s32i, !cir.ptr<!s32i>
  // CHECK-NEXT:     cir.for : cond {
  // CHECK-NEXT:       %[[TRUE:.*]] = cir.const #true
  // CHECK-NEXT:       cir.condition(%[[TRUE]])
  // CHECK-NEXT:     } body {
  // CHECK-NEXT:       cir.yield
  // CHECK-NEXT:     } step {
  // CHECK-NEXT:       cir.yield
  // CHECK-NEXT:     }
  // CHECK-NEXT:   }
  // CHECK-NEXT:   cir.return
  // CHECK-NEXT: }

  cir.func @l2() {
    cir.scope {
      cir.for : cond {
        %0 = cir.const #true
        cir.condition(%0)
      } body {
        cir.scope {
          %1 = cir.alloca !s32i, !cir.ptr<!s32i>, ["i", init] {alignment = 4 : i64}
          %2 = cir.const #cir.int<0> : !s32i
          cir.store %2, %1 : !s32i, !cir.ptr<!s32i>
        }
       cir.yield
      } step {
        cir.yield
      }
    }
    cir.return
  }
  // CHECK:      cir.func{{.*}} @l2
  // CHECK-NEXT:   %[[I:.*]] = cir.alloca !s32i, !cir.ptr<!s32i>, ["i", init] {alignment = 4 : i64}
  // CHECK-NEXT:   cir.scope {
  // CHECK-NEXT:     cir.for : cond {
  // CHECK-NEXT:       %[[TRUE:.*]] = cir.const #true
  // CHECK-NEXT:       cir.condition(%[[TRUE]])
  // CHECK-NEXT:     } body {
  // CHECK-NEXT:       cir.scope {
  // CHECK-NEXT:         %[[ZERO:.*]] = cir.const #cir.int<0> : !s32i
  // CHECK-NEXT:         cir.store %[[ZERO]], %[[I]] : !s32i, !cir.ptr<!s32i>
  // CHECK-NEXT:       }
  // CHECK-NEXT:       cir.yield
  // CHECK-NEXT:     } step {
  // CHECK-NEXT:       cir.yield
  // CHECK-NEXT:     }
  // CHECK-NEXT:   }
  // CHECK-NEXT:   cir.return
  // CHECK-NEXT: }

  cir.func @l3() {
    cir.scope {
      cir.for : cond {
        %0 = cir.const #true
        cir.condition(%0)
      } body {
        cir.scope {
          %1 = cir.alloca !s32i, !cir.ptr<!s32i>, ["i", init, const] {alignment = 4 : i64}
          %2 = cir.const #cir.int<0> : !s32i
          cir.store %2, %1 : !s32i, !cir.ptr<!s32i>
        }
       cir.yield
      } step {
        cir.yield
      }
    }
    cir.return
  }
  // CHECK:      cir.func{{.*}} @l3
  // CHECK-NEXT:   %[[I:.*]] = cir.alloca !s32i, !cir.ptr<!s32i>, ["i", init] {alignment = 4 : i64}
  // CHECK-NEXT:   cir.scope {
  // CHECK-NEXT:     cir.for : cond {
  // CHECK-NEXT:       %[[TRUE:.*]] = cir.const #true
  // CHECK-NEXT:       cir.condition(%[[TRUE]])
  // CHECK-NEXT:     } body {
  // CHECK-NEXT:       cir.scope {
  // CHECK-NEXT:         %[[ZERO:.*]] = cir.const #cir.int<0> : !s32i
  // CHECK-NEXT:         cir.store %[[ZERO]], %[[I]] : !s32i, !cir.ptr<!s32i>
  // CHECK-NEXT:       }
  // CHECK-NEXT:       cir.yield
  // CHECK-NEXT:     } step {
  // CHECK-NEXT:       cir.yield
  // CHECK-NEXT:     }
  // CHECK-NEXT:   }
  // CHECK-NEXT:   cir.return
  // CHECK-NEXT: }

  // Test: const alloca with store in for-loop condition region (opt level > 0)
  // The const flag should be removed when hoisting because the value changes
  // on each loop iteration.
  cir.func @for_cond_var() {
    cir.scope {
      %0 = cir.alloca !s32i, !cir.ptr<!s32i>, ["x", init, const] {alignment = 4 : i64}
      cir.for : cond {
        %1 = cir.const #cir.int<1> : !s32i
        cir.store %1, %0 : !s32i, !cir.ptr<!s32i>
        %2 = cir.load %0 : !cir.ptr<!s32i>, !s32i
        %3 = cir.cast int_to_bool %2 : !s32i -> !cir.bool
        cir.condition(%3)
      } body {
        cir.yield
      } step {
        cir.yield
      }
    }
    cir.return
  }
  // The const flag must be removed so the optimizer doesn't treat loads
  // as invariant across loop iterations.
  // CHECK:      cir.func{{.*}} @for_cond_var
  // CHECK-NEXT:   %[[X:.*]] = cir.alloca !s32i, !cir.ptr<!s32i>, ["x", init] {alignment = 4 : i64}
  // CHECK-NOT:    const
  // CHECK:        cir.for
  // CHECK:        cir.store
  // CHECK:      cir.return
  // CHECK-NEXT: }

  // Test: const alloca with store in while-loop condition region
  // Same pattern, but for while instead of for.
  cir.func @while_cond_var() {
    cir.scope {
      %0 = cir.alloca !s32i, !cir.ptr<!s32i>, ["y", init, const] {alignment = 4 : i64}
      cir.while {
        %1 = cir.const #cir.int<1> : !s32i
        cir.store %1, %0 : !s32i, !cir.ptr<!s32i>
        %2 = cir.load %0 : !cir.ptr<!s32i>, !s32i
        %3 = cir.cast int_to_bool %2 : !s32i -> !cir.bool
        cir.condition(%3)
      } do {
        cir.yield
      }
    }
    cir.return
  }
  // CHECK:      cir.func{{.*}} @while_cond_var
  // CHECK-NEXT:   %[[Y:.*]] = cir.alloca !s32i, !cir.ptr<!s32i>, ["y", init] {alignment = 4 : i64}
  // CHECK-NOT:    const
  // CHECK:        cir.while
  // CHECK:        cir.store
  // CHECK:      cir.return
  // CHECK-NEXT: }
}
