// RUN: cir-opt --cir-flatten-cfg %s -o - | FileCheck %s --check-prefix=DTOR
// RUN: cir-opt --cir-flatten-cfg %s -o - | FileCheck %s --check-prefix=CHAIN

// Cleanup-suffix sharing across shared, argument-taking cleanup chains.
//
// This is the CIR that clang emits at -O for
//
//   void test() { const std::vector<std::vector<int>> v{{0,0}, {1,1}, {2,2}}; }
//
// (names shortened, attributes dropped). Constructing element k can throw, so
// k's unwind edge has to destroy elements k-1..0 and the temporaries that are
// still live. CIRGen writes that out in full at every edge, so the cleanup
// bodies are quadratic in the element count. FlattenCFG is what repairs it: the
// tail of element k's cleanup is element k-1's cleanup verbatim, so k should
// branch into k-1 instead of carrying a copy.
//
// The chains are not private single-entry landing pads -- each one takes the
// in-flight exception pair as block arguments and is reached from more than one
// predecessor -- so sharing has to work on the cleanup region, not just the pad.

// One array-destroy loop per element, three, rather than one per unwind edge.
// DTOR-LABEL: cir.func @test()
// DTOR-COUNT-3: cir.call @vec_inner_dtor
// DTOR-NOT:     cir.call @vec_inner_dtor

// Every shared cleanup chain, and the shared resume tail, is a block taking the
// in-flight exception pair; predecessors hand the pair over rather than
// re-emitting the cleanup.
// CHAIN-LABEL: cir.func @test()
// CHAIN-COUNT-4: ^bb{{[0-9]+}}(%{{[0-9]+}}: !cir.ptr<!void>, %{{[0-9]+}}: !u32i):
// CHAIN-NOT:     ^bb{{[0-9]+}}(%{{[0-9]+}}: !cir.ptr<!void>, %{{[0-9]+}}: !u32i):

!s32i = !cir.int<s, 32>
!s64i = !cir.int<s, 64>
!u32i = !cir.int<u, 32>
!u64i = !cir.int<u, 64>
!u8i = !cir.int<u, 8>
!rec_newalloc_inner = !cir.record<class "std::__new_allocator<int>" padded {!u8i}>
!rec_newalloc_outer = !cir.record<class "std::__new_allocator<std::vector<int, std::allocator<int>>>" padded {!u8i}>
!rec_alloc_inner = !cir.record<class "std::allocator<int>" padded {!u8i}>
!rec_alloc_outer = !cir.record<class "std::allocator<std::vector<int, std::allocator<int>>>" padded {!u8i}>
!rec_anon_struct = !cir.record<struct  {!cir.ptr<!s32i>, !u64i}>
!rec_std3A3A_Vector_base3Cint2C_std3A3Aallocator3Cint3E3E3A3A_Vector_impl_data = !cir.record<struct "std::_Vector_base<int, std::allocator<int>>::_Vector_impl_data" {!cir.ptr<!s32i>, !cir.ptr<!s32i>, !cir.ptr<!s32i>}>
!rec_initlist_inner = !cir.record<class "std::initializer_list<int>" {!cir.ptr<!s32i>, !u64i}>
!rec_std3A3A_Vector_base3Cint2C_std3A3Aallocator3Cint3E3E3A3A_Vector_impl = !cir.record<struct "std::_Vector_base<int, std::allocator<int>>::_Vector_impl" {!rec_std3A3A_Vector_base3Cint2C_std3A3Aallocator3Cint3E3E3A3A_Vector_impl_data}>
!rec_std3A3A_Vector_base3Cint2C_std3A3Aallocator3Cint3E3E = !cir.record<struct "std::_Vector_base<int, std::allocator<int>>" {!rec_std3A3A_Vector_base3Cint2C_std3A3Aallocator3Cint3E3E3A3A_Vector_impl}>
!rec_vec_inner = !cir.record<class "std::vector<int, std::allocator<int>>" {!rec_std3A3A_Vector_base3Cint2C_std3A3Aallocator3Cint3E3E}>
!rec_anon_struct1 = !cir.record<struct  {!cir.ptr<!rec_vec_inner>, !u64i}>
!rec_std3A3A_Vector_base3Cstd3A3Avector3Cint2C_std3A3Aallocator3Cint3E3E2C_std3A3Aallocator3Cstd3A3Avector3Cint2C_std3A3Aallocator3Cint3E3E3E3E3A3A_Vector_impl_data = !cir.record<struct "std::_Vector_base<std::vector<int, std::allocator<int>>, std::allocator<std::vector<int, std::allocator<int>>>>::_Vector_impl_data" {!cir.ptr<!rec_vec_inner>, !cir.ptr<!rec_vec_inner>, !cir.ptr<!rec_vec_inner>}>
!rec_initlist_outer = !cir.record<class "std::initializer_list<std::vector<int, std::allocator<int>>>" {!cir.ptr<!rec_vec_inner>, !u64i}>
!rec_std3A3A_Vector_base3Cstd3A3Avector3Cint2C_std3A3Aallocator3Cint3E3E2C_std3A3Aallocator3Cstd3A3Avector3Cint2C_std3A3Aallocator3Cint3E3E3E3E3A3A_Vector_impl = !cir.record<struct "std::_Vector_base<std::vector<int, std::allocator<int>>, std::allocator<std::vector<int, std::allocator<int>>>>::_Vector_impl" {!rec_std3A3A_Vector_base3Cstd3A3Avector3Cint2C_std3A3Aallocator3Cint3E3E2C_std3A3Aallocator3Cstd3A3Avector3Cint2C_std3A3Aallocator3Cint3E3E3E3E3A3A_Vector_impl_data}>
!rec_std3A3A_Vector_base3Cstd3A3Avector3Cint2C_std3A3Aallocator3Cint3E3E2C_std3A3Aallocator3Cstd3A3Avector3Cint2C_std3A3Aallocator3Cint3E3E3E3E = !cir.record<struct "std::_Vector_base<std::vector<int, std::allocator<int>>, std::allocator<std::vector<int, std::allocator<int>>>>" {!rec_std3A3A_Vector_base3Cstd3A3Avector3Cint2C_std3A3Aallocator3Cint3E3E2C_std3A3Aallocator3Cstd3A3Avector3Cint2C_std3A3Aallocator3Cint3E3E3E3E3A3A_Vector_impl}>
!rec_vec_outer = !cir.record<class "std::vector<std::vector<int, std::allocator<int>>, std::allocator<std::vector<int, std::allocator<int>>>>" {!rec_std3A3A_Vector_base3Cstd3A3Avector3Cint2C_std3A3Aallocator3Cint3E3E2C_std3A3Aallocator3Cstd3A3Avector3Cint2C_std3A3Aallocator3Cint3E3E3E3E}>
