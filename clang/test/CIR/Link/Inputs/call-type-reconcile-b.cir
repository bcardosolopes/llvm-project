// Second input for ../call-type-reconcile.cir. Not a test on its own.
//
// Defines the callee using its own spelling of the record. Same body as the
// caller's, different name -- exactly the __va_list / std::__va_list split
// aarch64's libc and libc++ produce.

!s32i = !cir.int<s, 32>
!rec_impl = !cir.record<struct "impl::List" {!cir.ptr<!cir.void>, !s32i}>

module {
  cir.func @consume(%a: !rec_impl) -> !s32i {
    %0 = cir.const #cir.int<7> : !s32i
    cir.return %0 : !s32i
  }
}
