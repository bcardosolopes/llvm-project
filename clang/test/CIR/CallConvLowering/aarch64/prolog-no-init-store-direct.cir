// RUN: cir-opt %s --cir-call-conv-lowering -o /dev/null
//
// Regression test for buildFunctionProlog assertion when
// findArgInitStoreChain returns null for Direct-coerced arguments.
//
// Previously, buildFunctionProlog unconditionally asserted:
//   Assertion `(originalInitStore)' failed.
// when an arg had zero or multiple uses (so no unique init-store chain).
// The fix adds a fallback path (replaceArgWithoutInitStoreChain) that
// handles these cases gracefully.

!s32i = !cir.int<s, 32>
!s64i = !cir.int<s, 64>
!rec_Pair = !cir.record<struct "Pair" {!s64i, !s32i}>

module @"test" attributes {
  cir.ident = "test",
  cir.lang = #cir.lang<cxx>,
  cir.sob = #cir.signed_overflow_behavior<undefined>,
  cir.target_abi = "aapcs",
  cir.triple = "aarch64-none-linux-android23",
  cir.type_size_info = #cir.type_size_info<char = 8, int = 32, size_t = 64>,
  dlti.dl_spec = #dlti.dl_spec<
    !llvm.ptr<270> = dense<32> : vector<4xi64>,
    !llvm.ptr<271> = dense<32> : vector<4xi64>,
    !llvm.ptr<272> = dense<64> : vector<4xi64>,
    i8 = dense<[8, 32]> : vector<2xi64>,
    i16 = dense<[16, 32]> : vector<2xi64>,
    i64 = dense<64> : vector<2xi64>,
    i128 = dense<128> : vector<2xi64>,
    !llvm.ptr = dense<64> : vector<4xi64>,
    i1 = dense<8> : vector<2xi64>,
    i32 = dense<32> : vector<2xi64>,
    f16 = dense<16> : vector<2xi64>,
    f64 = dense<64> : vector<2xi64>,
    f128 = dense<128> : vector<2xi64>,
    "dlti.endianness" = "little",
    "dlti.mangling_mode" = "e",
    "dlti.legal_int_widths" = array<i32: 32, 64>,
    "dlti.stack_alignment" = 128 : i64,
    "dlti.function_pointer_alignment" = #dlti.function_pointer_alignment<32, function_dependent = true>
  >
} {
  // --- Case 1: Unused coerced struct parameter (zero uses). ---
  // On AArch64, rec_Pair is coerced to [2 x i64] (Direct). The original
  // arg has zero uses, so findArgInitStoreChain returns null.
  cir.func @unused_coerced_param(%arg0: !rec_Pair) -> !s32i {
    %0 = cir.const #cir.int<42> : !s32i
    cir.return %0 : !s32i
  }

  // --- Case 2: Coerced struct parameter stored to multiple allocas. ---
  // The original arg has two uses (two stores), so findArgInitStoreChain
  // returns null (requires exactly one use).
  cir.func @multi_store_coerced_param(%arg0: !rec_Pair) -> !s32i {
    %0 = cir.alloca !rec_Pair, !cir.ptr<!rec_Pair>, ["a"] {alignment = 8 : i64}
    %1 = cir.alloca !rec_Pair, !cir.ptr<!rec_Pair>, ["b"] {alignment = 8 : i64}
    cir.store align(8) %arg0, %0 : !rec_Pair, !cir.ptr<!rec_Pair>
    cir.store align(8) %arg0, %1 : !rec_Pair, !cir.ptr<!rec_Pair>
    %2 = cir.get_member %0[1] {name = "b"} : !cir.ptr<!rec_Pair> -> !cir.ptr<!s32i>
    %3 = cir.load align(4) %2 : !cir.ptr<!s32i>, !s32i
    cir.return %3 : !s32i
  }
}
