// The pass finds the records whose members hold a member pointer from the
// types the module uses, however they are reached. CIRGen used to mark them on
// the module and missed at least one record-completion path (a lambda capture
// holding a member-function pointer): a record left out keeps unlowered
// members next to lowered accesses, a get_member the verifier rejects.
//
// RUN: cir-opt --cir-cxxabi-lowering -o %t.cir %s
// RUN: FileCheck --input-file %t.cir %s

!s32i = !cir.int<s, 32>
!s64i = !cir.int<s, 64>
!S = !cir.record<struct "S" {!s32i}>
!Method = !cir.method<!cir.func<(!s32i)> in !S>
!Cap = !cir.record<class "anon.0" {!cir.ptr<!S>, !cir.ptr<!Method>}>

module attributes {
  cir.lang = #cir.lang<cxx>,
  cir.triple = "x86_64-unknown-linux-gnu",
  dlti.dl_spec = #dlti.dl_spec<i128 = dense<128> : vector<2xi64>, f80 = dense<128> : vector<2xi64>, !llvm.ptr<271> = dense<32> : vector<4xi64>, !llvm.ptr<272> = dense<64> : vector<4xi64>, i64 = dense<64> : vector<2xi64>, f16 = dense<16> : vector<2xi64>, i32 = dense<32> : vector<2xi64>, f128 = dense<128> : vector<2xi64>, !llvm.ptr<270> = dense<32> : vector<4xi64>, f64 = dense<64> : vector<2xi64>, !llvm.ptr = dense<64> : vector<4xi64>, i1 = dense<8> : vector<2xi64>, i8 = dense<8> : vector<2xi64>, i16 = dense<16> : vector<2xi64>, "dlti.stack_alignment" = 128 : i64, "dlti.endianness" = "little">
} {
  cir.func @f(%arg0: !cir.ptr<!Cap>) {
    %0 = cir.get_member %arg0[1] {name = "m"} : !cir.ptr<!Cap> -> !cir.ptr<!cir.ptr<!Method>>
    cir.return
  }
  // The record member is rewritten to the lowered struct alongside the
  // access: without the backstop scan the record keeps the method type
  // while the access lowers, which the verifier rejects.
  // CHECK: !cir.record<class "anon.0" {!cir.ptr<!{{.*}}>, !cir.ptr<!rec_anon_struct>}>
  // CHECK: cir.get_member %{{.*}} -> !cir.ptr<!cir.ptr<!rec_anon_struct>>
}
