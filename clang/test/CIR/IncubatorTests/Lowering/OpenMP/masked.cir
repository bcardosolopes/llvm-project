// RUN: cir-translate %s -cir-to-llvmir --disable-cc-lowering | FileCheck %s

!s32i = !cir.int<s, 32>

module {
  cir.func @omp_masked_1() {
    omp.masked {
      cir.call @work() : () -> ()
      omp.terminator
    }
    cir.return
  }

  cir.func @omp_masked_2(%arg0: !s32i) {
    %0 = builtin.unrealized_conversion_cast %arg0 : !s32i to i32
    omp.masked filter(%0 : i32) {
      cir.call @work() : () -> ()
      omp.terminator
    }
    cir.return
  }

  cir.func private @work() loc(#loc1)
}

#loc1 = loc("masked.cir":1:1)

// CHECK-LABEL: define void @omp_masked_1()
// CHECK: call i32 @__kmpc_global_thread_num(
// CHECK: call i32 @__kmpc_masked({{.*}}, i32 {{.*}}, i32 0)
// CHECK: call void @work()
// CHECK: call void @__kmpc_end_masked(
// CHECK-LABEL: define void @omp_masked_2(i32 %{{.*}})
// CHECK: call i32 @__kmpc_global_thread_num(
// CHECK: call i32 @__kmpc_masked({{.*}}, i32 {{.*}}, i32 %{{.*}})
// CHECK: call void @work()
// CHECK: call void @__kmpc_end_masked(
