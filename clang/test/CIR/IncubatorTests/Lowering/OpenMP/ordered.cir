// RUN: cir-translate %s -cir-to-llvmir --disable-cc-lowering | FileCheck %s

module {
  cir.func @f() {
    omp.ordered.region {
      cir.call @work() : () -> ()
      omp.terminator
    }
    cir.return
  }

  cir.func private @work() loc(#loc1)
}

#loc1 = loc("ordered.cir":1:1)

// CHECK-LABEL: define void @f()
// CHECK: call i32 @__kmpc_global_thread_num(
// CHECK: call void @__kmpc_ordered(
// CHECK: call void @work()
// CHECK: call void @__kmpc_end_ordered(
