// RUN: cir-translate %s -cir-to-llvmir --disable-cc-lowering | FileCheck %s

module {
  cir.func @omp_parallel_masked_taskloop_1() {
    %c0_i32 = llvm.mlir.constant(0 : i32) : i32
    %c8_i32 = llvm.mlir.constant(8 : i32) : i32
    %c1_i32 = llvm.mlir.constant(1 : i32) : i32
    omp.parallel {
      cir.scope {
        omp.masked {
          omp.taskloop {
            omp.loop_nest (%i) : i32 = (%c0_i32) to (%c8_i32) step (%c1_i32) {
              cir.call @work() : () -> ()
              omp.yield
            }
          }
          omp.terminator
        }
      }
      omp.terminator
    }
    cir.return
  }

  cir.func @omp_parallel_masked_taskloop_simd_1() {
    %c0_i32 = llvm.mlir.constant(0 : i32) : i32
    %c8_i32 = llvm.mlir.constant(8 : i32) : i32
    %c1_i32 = llvm.mlir.constant(1 : i32) : i32
    omp.parallel {
      cir.scope {
        omp.masked {
          omp.taskloop {
            omp.simd {
              omp.loop_nest (%i) : i32 = (%c0_i32) to (%c8_i32) step (%c1_i32) {
                cir.call @work() : () -> ()
                omp.yield
              }
            } {omp.composite}
          } {omp.composite}
          omp.terminator
        }
      }
      omp.terminator
    }
    cir.return
  }

  cir.func private @work() loc(#loc1)
}

#loc1 = loc("parallel-masked-taskloop.cir":1:1)

// CHECK-LABEL: define void @omp_parallel_masked_taskloop_1()
// CHECK: call void (ptr, i32, ptr, ...) @__kmpc_fork_call(
// CHECK: call i32 @__kmpc_masked(
// CHECK-DAG: call ptr @__kmpc_omp_task_alloc(
// CHECK-DAG: call void @__kmpc_taskloop(
// CHECK-DAG: call void @__kmpc_end_taskgroup(
// CHECK-DAG: call void @__kmpc_end_masked(
// CHECK-LABEL: define void @omp_parallel_masked_taskloop_simd_1()
// CHECK: call void (ptr, i32, ptr, ...) @__kmpc_fork_call(
// CHECK: call i32 @__kmpc_masked(
// CHECK-DAG: call ptr @__kmpc_omp_task_alloc(
// CHECK-DAG: call void @__kmpc_taskloop(
// CHECK-DAG: call void @__kmpc_end_taskgroup(
// CHECK-DAG: call void @__kmpc_end_masked(
