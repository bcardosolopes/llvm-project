// RUN: cir-translate %s -cir-to-llvmir --disable-cc-lowering | FileCheck %s

module {
  cir.func @omp_for_1() {
    %c0_i32 = llvm.mlir.constant(0 : i32) : i32
    %c8_i32 = llvm.mlir.constant(8 : i32) : i32
    %c1_i32 = llvm.mlir.constant(1 : i32) : i32
    omp.parallel {
      omp.wsloop {
        omp.loop_nest (%i) : i32 = (%c0_i32) to (%c8_i32) step (%c1_i32) {
          cir.call @work() : () -> ()
          omp.yield
        }
      }
      cir.call @after() : () -> ()
      omp.terminator
    }
    cir.return
  }

  cir.func @omp_for_nowait_1() {
    %c0_i32 = llvm.mlir.constant(0 : i32) : i32
    %c8_i32 = llvm.mlir.constant(8 : i32) : i32
    %c1_i32 = llvm.mlir.constant(1 : i32) : i32
    omp.parallel {
      omp.wsloop nowait {
        omp.loop_nest (%i) : i32 = (%c0_i32) to (%c8_i32) step (%c1_i32) {
          cir.call @work() : () -> ()
          omp.yield
        }
      }
      cir.call @after() : () -> ()
      omp.terminator
    }
    cir.return
  }

  cir.func private @work() loc(#loc1)
  cir.func private @after() loc(#loc2)
}

#loc1 = loc("for.cir":1:1)
#loc2 = loc("for.cir":2:1)

// CHECK-LABEL: define void @omp_for_1()
// CHECK: call void (ptr, i32, ptr, ...) @__kmpc_fork_call(
// CHECK-LABEL: define internal void @omp_for_1..omp_par
// CHECK: call void @__kmpc_for_static_init_4{{u?}}(
// CHECK: call void @__kmpc_barrier(
// CHECK: ret void

// CHECK-LABEL: define void @omp_for_nowait_1()
// CHECK: call void (ptr, i32, ptr, ...) @__kmpc_fork_call(
// CHECK-LABEL: define internal void @omp_for_nowait_1..omp_par
// CHECK: call void @__kmpc_for_static_init_4{{u?}}(
// CHECK-NOT: call void @__kmpc_barrier(
// CHECK: ret void
