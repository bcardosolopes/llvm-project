// RUN: cir-translate %s -cir-to-llvmir --disable-cc-lowering | FileCheck %s

module {
  cir.func @omp_single_1() {
    omp.single {
      cir.call @work() : () -> ()
      omp.terminator
    }
    cir.return
  }

  cir.func private @work() loc(#loc1)
}

#loc1 = loc("single.cir":1:1)

// CHECK-LABEL: define void @omp_single_1()
// CHECK: call i32 @__kmpc_single(
// CHECK: call void @work()
// CHECK: call void @__kmpc_end_single(
// CHECK: call void @__kmpc_barrier(
